# ==============================================================
# Eccomarket Backend — Environment Variables
# Salin file ini menjadi .env dan isi nilainya
# ==============================================================

# Server
PORT=3001

NODE_ENV=development

# PostgreSQL — ganti sesuai konfigurasi database kamu
DATABASE_URL="postgresql://user:password@localhost:5432/eccomerce"

# Pool pg (opsional, ada default-nya)
# PGPOOL_MAX=20
# PG_STATEMENT_TIMEOUT=30000

# JWT
JWT_SECRET=ganti_dengan_secret_yang_panjang_dan_acak
JWT_EXPIRES_IN=7d

# CORS — origin yang diizinkan (Next.js frontend)
CORS_ORIGIN=http://localhost:3000

# Mitra resmi yang dipakai untuk semua produk dari admin dashboard
# Isi dengan ID mitra "Jernih Creatife Official Store" dari tabel mitras
ADMIN_MITRA_ID=isi_dengan_mitra_id_dari_database

# Midtrans — sandbox (ganti ke true + server key production saat go-live)
MIDTRANS_SERVER_KEY=Mid-server-xxxx
MIDTRANS_CLIENT_KEY=Mid-client-xxxx
MIDTRANS_IS_PRODUCTION=false

# RajaOngkir — API key HANYA di backend (jangan pernah di frontend)
RAJAONGKIR_API_KEY=U16vRtzu9ba1c273727739fftkwo4lQV
# Asal pengiriman (API V2 menghitung per kelurahan/sub-district).
# RAJAONGKIR_ORIGIN_ID — sub-district id toko (direkomendasikan, deterministik).
#   Cari id via GET https://rajaongkir.komerce.id/api/v1/destination/domestic-destination?search=<nama kota>
#   (header: key) lalu pakai `id` yang sesuai dengan lokasi toko.
# Jika ORIGIN_ID kosong, fallback ke ORIGIN_QUERY (auto-resolve, default "Klaten").
RAJAONGKIR_ORIGIN_ID=62507
RAJAONGKIR_ORIGIN_QUERY=Klaten

# Shipping Eligibility Engine (backend adalah sumber kebenaran).
# Service cargo/trucking (JNE JTR & varian band-nya) hanya dipakai untuk
# kiriman berat. Berat minimum trucking dalam kg:
# CARGO_MIN_WEIGHT_KG=100
# Matikan/nyalakan masing-masing service JTR (default aktif):
# JTR_ENABLED=true
# JTR_LT_130_ENABLED=true
# JTR_GT_130_ENABLED=true
# JTR_GT_200_ENABLED=true

# Optional: verifikasi tambahan webhook (harus sama dengan merchant_id Midtrans)
# MIDTRANS_MERCHANT_ID=

# Webhook URL yang didaftarkan di dashboard Midtrans (Payment notification URL, produksi harus HTTPS)
# MIDTRANS_WEBHOOK_URL=https://api.domain.com/api/payments/midtrans/notification
